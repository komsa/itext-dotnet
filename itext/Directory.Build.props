<Project>
    <!-- Build.props file evaluated before .csrpoj file processing -->
    <PropertyGroup Label="Common">
        <TargetFramework>netstandard2.0</TargetFramework>
        <RootNamespace />
        
        <!-- Signing -->
        <SignAssembly>true</SignAssembly>
        <DelaySign>false</DelaySign>
        <AssemblyOriginatorKeyFile>itext.snk</AssemblyOriginatorKeyFile>

        <!-- SDK-generated assembly attributes; title/description/configuration stay
             hand-maintained in each project's Properties/AssemblyInfo.cs -->
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
        <GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
        <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>

        <!-- Versioning: AssemblyVersion is pinned across 9.x KOMSA revisions -->
        <VersionPrefix>9.8.0.1</VersionPrefix>
        <AssemblyVersion>9.0.0.0</AssemblyVersion>
        <FileVersion>9.8.0.1</FileVersion>
        <InformationalVersion>9.8.0.1</InformationalVersion>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

        <!-- Branding -->
        <Company>KOMSA GmbH</Company>
        <Product>iText</Product>
        <Authors>KOMSA GmbH</Authors>
        <Copyright>Copyright (c) 1998-2026 KOMSA GmbH</Copyright>

        <!-- Output -->
        <OutputType>library</OutputType>

        <!-- Compiler -->
        <WarningLevel>0</WarningLevel>

        <!-- Debug symbols / SourceLink -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <DebugType>portable</DebugType>

        <!-- Warnings -->
        <NoWarn>1701;1702;1591;1570;1572;1573;1574;1580;1584;1658</NoWarn>
        
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    </ItemGroup>
</Project>