  <PropertyGroup>
    <AssemblyName>itext.bouncy-castle-adapter</AssemblyName>
    <!-- NuGet package metadata (replaces the former hand-written .nuspec) -->
    <PackageId>Komsa.itext.bouncy-castle-adapter</PackageId>
    <Title>iText bouncy-castle adapter module</Title>
    <Description>Bouncy-castle adapter module</Description>
