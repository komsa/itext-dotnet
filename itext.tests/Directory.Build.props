<Project>
    <!-- Repo-root Directory.Build.props is not auto-imported once this file exists -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <!-- Build.props file evaluated before .csrpoj file processing -->
    <PropertyGroup Label="Common">
        <TargetFrameworks>net10.0</TargetFrameworks>
        <!-- SDK-generated assembly attributes; title/description/configuration stay
             hand-maintained in each project's Properties/AssemblyInfo.cs -->
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
        <GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
        <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>

        <!-- Version and branding come from the repo-root Directory.Build.props -->

        <!-- Never produce NuGet packages from test projects -->
        <IsPackable>false</IsPackable>

        <!-- Output -->
        <OutputType>library</OutputType>

        <!-- Compiler -->
        <WarningLevel>0</WarningLevel>

        <!-- Warnings -->
        <NoWarn>1701;1702;1591;1570;1572;1573;1574;1580;1584;1658</NoWarn>
        <!-- TODO DEVSIX-9075: remove this suppression -->
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>

        <RootNamespace/>
    </PropertyGroup>

    <PropertyGroup>
        <DefineConstants>NETSTANDARD2_0</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NUnit" Version="3.14.0"/>
        <PackageReference Include="NUnit3TestAdapter" Version="4.6.0"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1"/>
    </ItemGroup>

</Project>
